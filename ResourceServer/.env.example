# MiniAuth Resource Server Environment Variables

# Server Settings
HOST=0.0.0.0
PORT=8082
APP_ENV=development
LOG_LEVEL=debug

# JWT Verification via Authorization Server JWKS or Public Key
ISSUER_URL=http://localhost:8080
JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUDIENCE=

# Local Public Key fallback (if JWKS server is unreachable)
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
