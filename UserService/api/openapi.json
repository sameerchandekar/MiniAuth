{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniAuth UserService API",
    "description": "RESTful API for managing users, roles, permissions, and RBAC assignments in the MiniAuth platform.",
    "version": "1.0.0",
    "contact": {
      "name": "MiniAuth"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server (Auto-detected from browser)"
    }
  ],
  "tags": [
    { "name": "Users", "description": "User creation, queries, and role assignments" },
    { "name": "Roles", "description": "Role creation, listing, and permission assignments" },
    { "name": "Permissions", "description": "Permission creation and listing" },
    { "name": "Clients", "description": "OAuth 2.0 client registration, scopes, and redirect URIs" },
    { "name": "Health", "description": "Service health probes" }
  ],
  "paths": {
    "/api/v1/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user",
        "description": "Creates a new user with a bcrypt-hashed password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseWrapper"
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already exists" }
        }
      },
      "get": {
        "tags": ["Users"],
        "summary": "List all users",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponseWrapper"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user details",
        "description": "Returns full user profile along with assigned roles and resolved permissions.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Full user details with roles and permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDetailResponseWrapper"
                }
              }
            }
          },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/v1/users/{id}/roles": {
      "post": {
        "tags": ["Users"],
        "summary": "Assign a role to a user",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Role assigned successfully" },
          "404": { "description": "User or Role not found" }
        }
      }
    },
    "/api/v1/users/{id}/roles/{roleId}": {
      "delete": {
        "tags": ["Users"],
        "summary": "Remove a role from a user",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "roleId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Role removed successfully" },
          "400": { "description": "Role was not assigned to user" }
        }
      }
    },
    "/api/v1/roles": {
      "post": {
        "tags": ["Roles"],
        "summary": "Create a new role",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoleRequest"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Role created" },
          "400": { "description": "Validation error" },
          "409": { "description": "Role name already exists" }
        }
      },
      "get": {
        "tags": ["Roles"],
        "summary": "List all roles with their permissions",
        "responses": {
          "200": { "description": "List of roles" }
        }
      }
    },
    "/api/v1/roles/{id}": {
      "get": {
        "tags": ["Roles"],
        "summary": "Get role by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Role found" },
          "404": { "description": "Role not found" }
        }
      }
    },
    "/api/v1/roles/{id}/permissions": {
      "post": {
        "tags": ["Roles"],
        "summary": "Assign a permission to a role",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignPermissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Permission assigned to role" },
          "404": { "description": "Role or Permission not found" }
        }
      }
    },
    "/api/v1/roles/{id}/permissions/{permissionId}": {
      "delete": {
        "tags": ["Roles"],
        "summary": "Remove a permission from a role",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "permissionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Permission removed from role" }
        }
      }
    },
    "/api/v1/permissions": {
      "post": {
        "tags": ["Permissions"],
        "summary": "Create a new permission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePermissionRequest"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Permission created" },
          "409": { "description": "Permission already exists" }
        }
      },
      "get": {
        "tags": ["Permissions"],
        "summary": "List all permissions",
        "responses": {
          "200": { "description": "List of permissions" }
        }
      }
    },
    "/api/v1/permissions/{id}": {
      "get": {
        "tags": ["Permissions"],
        "summary": "Get permission by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Permission found" },
          "404": { "description": "Permission not found" }
        }
      }
    },
    "/api/v1/clients": {
      "post": {
        "tags": ["Clients"],
        "summary": "Register a new OAuth 2.0 client",
        "description": "Registers a new OAuth 2.0 client application with initial redirect URIs and scopes. Returns the generated or assigned client_secret for confidential clients.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterClientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponseWrapper"
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "409": { "description": "Client ID already exists" }
        }
      },
      "get": {
        "tags": ["Clients"],
        "summary": "List registered clients",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "List of clients",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientListResponseWrapper"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clients/{clientId}": {
      "get": {
        "tags": ["Clients"],
        "summary": "Get client details",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Client details with redirect URIs and scopes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponseWrapper"
                }
              }
            }
          },
          "404": { "description": "Client not found" }
        }
      },
      "delete": {
        "tags": ["Clients"],
        "summary": "Delete client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Client deleted successfully" },
          "404": { "description": "Client not found" }
        }
      }
    },
    "/api/v1/clients/{clientId}/scopes": {
      "post": {
        "tags": ["Clients"],
        "summary": "Add scopes to client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Scopes added successfully" },
          "404": { "description": "Client not found" }
        }
      },
      "put": {
        "tags": ["Clients"],
        "summary": "Replace / overwrite all scopes of client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Scopes replaced successfully" },
          "404": { "description": "Client not found" }
        }
      }
    },
    "/api/v1/clients/{clientId}/scopes/{scope}": {
      "delete": {
        "tags": ["Clients"],
        "summary": "Remove scope from client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "scope", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Scope removed successfully" },
          "404": { "description": "Client not found" }
        }
      }
    },
    "/api/v1/clients/{clientId}/redirect-uris": {
      "post": {
        "tags": ["Clients"],
        "summary": "Add redirect URIs to client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRedirectURIRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Redirect URIs added successfully" },
          "404": { "description": "Client not found" }
        }
      },
      "put": {
        "tags": ["Clients"],
        "summary": "Replace / overwrite all redirect URIs of client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRedirectURIRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Redirect URIs replaced successfully" },
          "404": { "description": "Client not found" }
        }
      },
      "delete": {
        "tags": ["Clients"],
        "summary": "Remove redirect URI from client",
        "parameters": [
          { "name": "clientId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "redirect_uri": { "type": "string", "example": "https://myapp.com/callback" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Redirect URI removed successfully" },
          "404": { "description": "Client not found" }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness probe",
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["Health"],
        "summary": "Readiness probe",
        "responses": {
          "200": { "description": "Service is ready" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "Alice Smith" },
          "email": { "type": "string", "format": "email", "example": "alice@example.com" },
          "password": { "type": "string", "format": "password", "minLength": 8, "example": "SecurePass123!" }
        }
      },
      "UserResponseWrapper": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "user created successfully" },
          "data": { "$ref": "#/components/schemas/UserResponse" }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserListResponseWrapper": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserResponse" }
          }
        }
      },
      "UserDetailResponseWrapper": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/UserDetailResponse" }
        }
      },
      "UserDetailResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Alice Smith" },
          "email": { "type": "string", "example": "alice@example.com" },
          "roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoleSummary" }
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["read:users", "write:users", "admin:all"]
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RoleSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "admin" },
          "permissions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Permission" }
          }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "admin" }
        }
      },
      "AssignRoleRequest": {
        "type": "object",
        "required": ["role_id"],
        "properties": {
          "role_id": { "type": "string", "format": "uuid", "example": "c56a4180-65aa-42ec-a945-5fd21dec0538" }
        }
      },
      "CreatePermissionRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "read:users" }
        }
      },
      "AssignPermissionRequest": {
        "type": "object",
        "required": ["permission_id"],
        "properties": {
          "permission_id": { "type": "string", "format": "uuid", "example": "a12b34cd-56ef-78gh-90ij-1234567890ab" }
        }
      },
      "Permission": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "read:users" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterClientRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "client_id": { "type": "string", "example": "my-demo-app" },
          "client_secret": { "type": "string", "example": "custom_secret_key" },
          "name": { "type": "string", "example": "Demo Application" },
          "client_type": { "type": "string", "enum": ["confidential", "public"], "default": "confidential" },
          "redirect_uris": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "example": ["https://myapp.com/oauth/callback"]
          },
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["openid", "profile", "email", "read:files"]
          }
        }
      },
      "ClientResponseWrapper": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "client registered successfully" },
          "data": { "$ref": "#/components/schemas/ClientResponse" }
        }
      },
      "ClientListResponseWrapper": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ClientResponse" }
          }
        }
      },
      "ClientResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "client_id": { "type": "string", "example": "my-demo-app" },
          "client_secret": { "type": "string", "example": "3b8c6f1a...", "description": "Only returned upon registration for confidential clients" },
          "name": { "type": "string", "example": "Demo Application" },
          "client_type": { "type": "string", "enum": ["confidential", "public"] },
          "redirect_uris": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["https://myapp.com/oauth/callback"]
          },
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["openid", "profile", "email"]
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AddScopeRequest": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "example": "write:files" },
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["write:files", "admin:all"]
          }
        }
      },
      "AddRedirectURIRequest": {
        "type": "object",
        "properties": {
          "redirect_uri": { "type": "string", "format": "uri", "example": "https://myapp.com/callback" },
          "redirect_uris": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "example": ["https://myapp.com/callback", "http://localhost:3000/callback"]
          }
        }
      }
    }
  }
}
