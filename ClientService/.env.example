# MiniAuth Client Service Environment Variables

# Server Settings
HOST=0.0.0.0
PORT=9000
APP_ENV=development
LOG_LEVEL=debug

# OAuth 2.0 Identity Provider (Authorization Server)
AUTH_SERVER_URL=http://localhost:8080

# Client Credentials & Callback
CLIENT_ID=client-id-001
CLIENT_SECRET=
REDIRECT_URI=http://localhost:9000/oauth/callback
SCOPES=openid profile email

# Redis Configuration (For State ID & PKCE code_verifier storage)
REDIS_ADDR=localhost:6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
