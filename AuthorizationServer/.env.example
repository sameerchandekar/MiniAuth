# MiniAuth Authorization Server Environment Variables

# Server Settings
HOST=0.0.0.0
PORT=8080
APP_ENV=development
LOG_LEVEL=debug
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Identity Provider / Issuer URL
ISSUER_URL=http://localhost:8080

# Database Configuration
# Option 1: Direct connection string (e.g. Neon, Supabase, AWS RDS, Heroku)
DATABASE_URL=postgresql://neondb_owner:<password>@ep-bold-sound-ay01smo4.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual database parameters (used if DATABASE_URL is not provided)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=miniauth
# DB_SSLMODE=disable

# Auto-apply Flyway database migrations on server startup (true / false)
DB_AUTO_MIGRATE=true

# Redis Cache & Session Store
# Option 1: Direct Redis URL (e.g. Upstash, Redis Cloud, Heroku Redis)
# REDIS_URL=redis://default:password@host:port/0

# Option 2: Individual parameters (used if REDIS_URL is not provided)
REDIS_ADDR=localhost:6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0

# JWT & RSA Cryptographic Signing (RS256)
JWT_KEY_ID=miniauth-key-1
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
# Alternatively provide inline PEMs:
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_TTL=1h


